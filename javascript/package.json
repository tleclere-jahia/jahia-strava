{
  "name": "jahia-strava-js",
  "version": "1.0.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.cnd",
    "settings",
    "static"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && yarn package",
    "clean": "rm -rf dist/",
    "deploy": "jahia-deploy",
    "dev": "vite build --watch",
    "format": "prettier --write --list-different .",
    "lint": "eslint .",
    "package": "yarn pack --out dist/package.tgz",
    "watch": "yarn dev",
    "watch:callback": "yarn package && yarn deploy"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@jahia/javascript-modules-library": "^1.3.1",
    "@jahia/vite-plugin": "^1.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.fullscreen": "^5.2.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "i18next": "^26.7.2",
    "prettier": "^3.8.1",
    "react": "^19.1.10",
    "react-i18next": "^17.1.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "jahia": {
    "name": "jahia-strava-js",
    "required-version": "8.2.1.0",
    "module-type": "module",
    "module-dependencies": "default,javascript-modules-engine=[1.3,2),jahia-strava=[1,2)",
    "server": "dist/server/index.js",
    "static-resources": "/dist/assets,/dist/client,/locales,/icons,/images"
  }
}
