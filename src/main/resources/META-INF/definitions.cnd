<foont = 'http://www.foo.org/jahia/nt/1.0'>
<jcr = 'http://www.jcp.org/jcr/1.0'>
<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>

[foont:stravaActivity] > jnt:content, mix:title, jmix:autoPublish
 - jcr:title (string)
 - date (date) mandatory
 - jsonValue (string) hidden protected mandatory

[foont:stravaActivities] > jnt:contentFolder
 + * (foont:stravaActivity)

// No longer used: the map of a user is a foont:stravaProfileMap. Kept as deployed, since Jahia
// refuses to remove a supertype from a deployed definition
[foont:stravaMap] > jnt:content, mix:title, jmix:structuredContent

// The map of a user, created under their node by StravaProfileListener: no contributor drops it
[foont:stravaProfileMap] > jnt:content

// The Strava profile of a user: once stravaUrl is set, the user gets a map of their own under
// their node, served at /strava/<login>
[foont:stravaProfile] mixin
 extends = jnt:user
 - stravaUrl (string) < '^https://www[.]strava[.]com/athletes/[0-9]+/?$'
